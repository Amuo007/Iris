\documentclass[9.5pt, letterpaper]{article}
\usepackage[
    ignoreheadfoot,
    top=1.2cm,
    bottom=1.2cm,
    left=1.5cm,
    right=1.5cm,
    footskip=0.5cm
]{geometry}
\usepackage{titlesec}
\usepackage{enumitem}
\usepackage{hyperref}
\usepackage{lastpage}
\usepackage{changepage}
\pagestyle{empty}
\setcounter{secnumdepth}{0}
\setlength{\parindent}{0pt}
\setlength{\topskip}{0pt}
\titleformat{\section}{\bfseries\large}{}{0pt}{}[\titlerule]
\titlespacing{\section}{0pt}{0.16cm}{0.12cm}
\renewcommand\labelitemi{$\bullet$}
\newenvironment{onecolentry}{
    \begin{adjustwidth}{0.2cm}{0.2cm}
}{
    \end{adjustwidth}
}
% ---- resuma measurement hooks (layout-neutral: only \typeout to the log) ----
\newlength{\resumaW}
\newcommand{\resumaEmit}[2]{%
  \edef\resumaL{\the\prevgraf}%
  \settowidth{\resumaW}{#2}%
  \typeout{RESUMA|#1|lines=\resumaL|width=\the\resumaW|linewidth=\the\linewidth}%
}
\newcommand{\resumaItem}[2]{\item #2\par\resumaEmit{#1}{#2}}
\newcommand{\resumaRow}[2]{#2\par\resumaEmit{#1}{#2}}
\begin{document}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%                           HEADER
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\begin{center}
    {\bf\fontsize{22pt}{22pt}\selectfont << name >>} \\[0.2cm]
    << contact.location >> \quad | \quad
    \href{mailto:<< contact.email >>}{<< contact.email >>} \quad | \quad
    << contact.phone >> \\[0.1cm]
    \href{<< contact.linkedin_url >>}{<< contact.linkedin_label >>} \quad | \quad
    \href{<< contact.github_url >>}{<< contact.github_label >>}
\end{center}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%                           EDUCATION
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\section{Education}
\resumaRow{edu.school}{<< education.school >>}%
\resumaRow{edu.degree}{\textbf{<< education.degree >>} \hfill \textbf{<< education.date >>}}%
\resumaRow{edu.coursework}{\textbf{Relevant Coursework:} << coursework >>}%

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%                           EXPERIENCE
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\section{Experience}
<% for e in experience %>
<% set ei = loop.index %>
\resumaRow{exp<< ei >>.head}{\textbf{<< e.title >>}, << e.org >> $\cdot$ << e.qualifier >> \hfill \textbf{<< e.dates >>}}%
\begin{itemize}[leftmargin=0.5cm, itemsep=0.05cm, topsep=0.05cm, parsep=0pt, partopsep=0pt]
<% for b in e.bullets %>
    \resumaItem{exp<< ei >>.b<< loop.index >>}{<< b >>}
<% endfor %>
\end{itemize}
<% if not loop.last %>
\vspace{0.05cm}
<% endif %>
<% endfor %>

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%                           PROJECTS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\section{Project Experience}
<% for p in projects %>
<% set pi = loop.index %>
\resumaRow{proj<< pi >>.head}{\textbf{<< p.title >>}<% if p.subtitle %>, << p.subtitle >><% endif %> \hfill \textbf{<< p.dates >>}}%
\begin{itemize}[leftmargin=0.5cm, itemsep=0.05cm, topsep=0.05cm, parsep=0pt, partopsep=0pt]
<% for b in p.bullets %>
    \resumaItem{proj<< pi >>.b<< loop.index >>}{<< b >>}
<% endfor %>
\end{itemize}
<% if not loop.last %>
\vspace{0.05cm}
<% endif %>
<% endfor %>

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%                           TECHNICAL SKILLS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\section{Technical Skills}
\begin{onecolentry}
<% for r in skills %>
\resumaRow{skills.<< loop.index >>}{\textbf{<< r.label >>:} << r.itemstr >>}%
<% endfor %>
\end{onecolentry}

\end{document}
